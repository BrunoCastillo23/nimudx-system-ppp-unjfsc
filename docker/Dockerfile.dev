# === Imagen de Desarrollo: PHP-FPM + Node (hot-reload, bind mount de código) ===
FROM php:8.4-fpm

# Dependencias del sistema + Node.js.
# pcntl se instala aquí (a diferencia de Windows nativo, donde no existe),
# así que dentro de este contenedor sí funciona Laravel Pail.
# mariadb-client aporta `mysqladmin`, usado por el entrypoint para esperar a la BD.
RUN apt-get update && apt-get install -y \
    git unzip zip curl libpng-dev libjpeg-dev libfreetype6-dev libonig-dev libxml2-dev libzip-dev mariadb-client \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_mysql mbstring zip exif pcntl gd bcmath

# Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

WORKDIR /var/www

# El código fuente NO se copia aquí: se monta como volumen desde
# docker-compose.yml (bind mount), para que los cambios en el host se
# reflejen al instante (hot-reload). vendor/ y node_modules/ se instalan
# en tiempo de arranque (ver docker/entrypoint.dev.sh) dentro de volúmenes
# Docker nombrados, separados del bind mount.
COPY docker/entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh

EXPOSE 8000 5173

ENTRYPOINT ["/usr/local/bin/entrypoint.dev.sh"]
